DISCORD_TOKEN=tu_token_aca

# ID de tu server de Discord (activa el Modo Desarrollador en Discord,
# click derecho sobre el icono del server -> "Copiar ID del servidor")
GUILD_ID=tu_guild_id_aca

# Opcional: si lo dejas vacio, el bot mide actividad en todos los canales de texto del server
# Lista de IDs de canal separados por coma, para limitar donde puede mandar tips
TIPS_CHANNEL_WHITELIST=

# Cada cuanto manda el tip, en minutos (default 20). Esto ahora tambien se puede
# cambiar desde el dashboard web, una vez que lo configures.
TIPS_INTERVAL_MINUTES=20

# Silencia los mensajes promocionales que imprime una dependencia interna de "natural"
DOTENV_CONFIG_QUIET=true

# --- Dashboard web ---

# Developer Portal -> tu app -> General Information -> Application ID
DISCORD_CLIENT_ID=tu_client_id_aca

# Developer Portal -> tu app -> OAuth2 -> Client Secret (Reset Secret si no lo tenes)
DISCORD_CLIENT_SECRET=tu_client_secret_aca

# URL publica donde va a vivir el dashboard (la de Render), sin barra al final
DASHBOARD_URL=https://tu-servicio.onrender.com

# String random para firmar las cookies de sesion. Cualquier texto largo y unico sirve.
SESSION_SECRET=cambia_esto_por_algo_random_y_largo

# --- Base de datos (MongoDB Atlas) ---
MONGODB_URI=tu_connection_string_de_mongodb_atlas_aca
MONGODB_DB_NAME=discordTipsBot
